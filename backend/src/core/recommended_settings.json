{
    "editor.gotoLocation.multipleDefinitions": "peek",
    "editor.gotoLocation.multipleImplementations": "peek",
    "editor.linkedEditing": true,
    "editor.suggest.showKeywords": true,
    "editor.suggest.showSnippets": true,
    "workbench.reduceMotion": "auto",
    "workbench.list.defaultFindMode": "highlight",
    "workbench.list.typeNavigationMode": "automatic",
    "java.jdt.ls.java.home": null,
    "search.usePCRE2": true,
    "update.mode": "default",
    "comments.openView": "firstFile",
    "editor.colorDecorators": true,
    "java.import.generatesMetadataFilesAtProjectRoot": false,
    "extensions.ignoreRecommendations": false,
    "chat.tools.terminal.autoApprove": true,
    "terminal.integrated.shellIntegration.timeout": 5000,
    "terminal.integrated.enableVisualBell": true,
    "accessibility.signals.terminalBell": { "sound": "on" },
    "java.cleanup.actions": [],
    "telemetry.telemetryLevel": "all",
    "chat.detectParticipant.enabled": true,
    "github.gitAuthentication": true,
    "githubPullRequests.defaultCreateOption": "last",
    "githubPullRequests.remotes": ["origin"]
}
