# GitHub Deployment Secrets Template
# Copy to secrets.env, fill in values, then run:
# ./scripts/setup-deployment-env.sh --org yourorg --repo yourrepo --file secrets.env

# ========================================
# REQUIRED SECRETS
# ========================================

# JWT Secret (minimum 32 random characters)
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars

# Ollama API Key
OLLAMA_API_KEY=your-ollama-api-key

# OWASP ZAP API Key
ZAP_API_KEY=your-zap-api-key

# ========================================
# STAGING ENVIRONMENT
# ========================================

# Staging server SSH connection
STAGING_HOST=staging.example.com
STAGING_USER=deploy
STAGING_SSH_KEY=LS0tLS1CRUdJTi... # base64 encoded private key

# ========================================
# PRODUCTION ENVIRONMENT
# ========================================

# Production server SSH connection
PROD_HOST=prod.example.com
PROD_USER=deploy
PROD_SSH_KEY=LS0tLS1CRUdJTi... # base64 encoded private key

# Admin credentials
ADMIN_EMAIL=admin@cybersurx.io
ADMIN_DEFAULT_PASSWORD=SecurePassword123!

# Database
DATABASE_URL=postgresql://user:password@prod-db.internal:5432/cybersurx

# Redis
REDIS_PASSWORD=RedisSecurePassword123!

# ========================================
# OPTIONAL: ERROR TRACKING (Sentry)
# ========================================

SENTRY_DSN_STAGING=https://xxxxx@sentry.io/project
SENTRY_DSN_PRODUCTION=https://xxxxx@sentry.io/project

# ========================================
# OPTIONAL: NOTIFICATIONS (Slack)
# ========================================

SLACK_WEBHOOK=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXX

# ========================================
# OPTIONAL: KUBERNETES
# ========================================

# Kubeconfig base64 encoded:
# base64 -i ~/.kube/config
K8S_KUBECONFIG=LS0tLS1CRUdJTi... # base64 encoded kubeconfig

# ========================================
# OPTIONAL: AWS (ECS DEPLOYMENTS)
# ========================================

AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
