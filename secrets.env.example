# Generate strong independent secrets. Never deploy this template unchanged.
APP_ENV=production
SEED_ADMIN=false
ADMIN_EMAIL=
ADMIN_DEFAULT_PASSWORD=
POSTGRES_USER=neomnix
POSTGRES_PASSWORD=
POSTGRES_DB=neomnix_db
DATABASE_URL=
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
REDIS_URL=redis://redis:6379/0
ALLOWED_ORIGINS=https://your-actual-domain.example
# Explicit authorization scope; empty disables network scans.
SCAN_ALLOWED_CIDRS=
ZAP_HOST=zap
ZAP_PORT=8080
ZAP_API_KEY=
# Optional AI recommendations; review data handling before enabling.
LLM_API_BASE=http://ollama:11434
LLM_MODEL=llama3
REMEDIATION_CACHE_TTL=86400
# Optional display, PDF font and AI-cache overrides; defaults are safe to omit.
# PLATFORM_NAME=Neomnix
# NEOMNIX_TTF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# NEOMNIX_TTF_BOLD_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# NEOMNIX_DISABLE_TTF=0
# REMEDIATION_CACHE_TTL=86400
