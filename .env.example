# Neomnix Production Configuration Template
# Copy to .env and fill in actual values from your infrastructure

# Environment
ENVIRONMENT=production

# Database (PostgreSQL 17)
DATABASE_URL=postgresql://compliance_admin:CHANGE_ME_SECURE_PASSWORD@postgres-prod.internal:5432/neomnix_db
POSTGRES_USER=compliance_admin
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=neomnix_db

# Redis (Message Broker)
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis-prod.internal:6379/0

# Stripe Integration (GET FROM: https://dashboard.stripe.com/apikeys)
STRIPE_API_KEY=PLACEHOLDER
STRIPE_WEBHOOK_SECRET=PLACEHOLDER
STRIPE_STARTER_PRICE_ID=price_1SdOlkAYPKqxMcp8StarterMonthly
STRIPE_PROFESSIONAL_PRICE_ID=price_1SdOlkAYPKqxMcp8ProfessionalMonthly
STRIPE_ENTERPRISE_PRICE_ID=price_1SdOlkAYPKqxMcp8EnterpriseMonthly

# JWT Authentication (Generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=CHANGE_ME_GENERATE_SECURE_256BIT_KEY
JWT_EXPIRE_MINUTES=480

# Administrator Account
ADMIN_EMAIL=admin@neomnix.io
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_SECURE_PASSWORD_16CHARS_MINIMUM

# API Configuration
ALLOWED_ORIGINS=https://neomnix.io,https://app.neomnix.io
LOG_LEVEL=info

# AI/LLM Configuration (Ollama Cloud API)
OLLAMA_API_KEY=CHANGE_ME_OLLAMA_API_KEY
LLM_API_BASE=https://ollama.com/api
LLM_MODEL=qwen3-coder:480b-cloud

# Security Scanner (OWASP ZAP)
ZAP_API_KEY=CHANGE_ME_SECURE_ZAP_API_KEY
ZAP_HOST=zap

# Monitoring & Error Tracking (Optional)
SENTRY_DSN=https://YOUR_SENTRY_KEY@sentry.io/PROJECT_ID

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PRODUCTION DEPLOYMENT CHECKLIST
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Before deploying to production:
#
# 1. DATABASE
#    ✓ Replace localhost with actual PostgreSQL server (RDS, Managed DB, etc.)
#    ✓ Use strong password (min 32 chars, alphanumeric + special chars)
#    ✓ Enable SSL/TLS for database connection
#    ✓ Configure automated backups (daily minimum)
#    ✓ Set up read replicas for HA
#
# 2. STRIPE
#    ✓ Use LIVE API key (sk_live_..., not sk_test_...)
#    ✓ Set webhook endpoint in Stripe Dashboard to: https://api.neomnix.io/webhooks/stripe
#    ✓ Test webhook delivery and error handling
#    ✓ Configure all product prices in Stripe Dashboard
#
# 3. JWT/SECURITY
#    ✓ Generate new JWT_SECRET_KEY (never reuse dev/staging secrets)
#    ✓ Change ADMIN_DEFAULT_PASSWORD and force reset on first login
#    ✓ Enable HTTPS/TLS for all endpoints
#    ✓ Configure CORS for your domain only
#
# 4. ENVIRONMENT
#    ✓ Set ENVIRONMENT=production (not staging/development)
#    ✓ Review ALLOWED_ORIGINS - restrict to your domain
#    ✓ Set LOG_LEVEL=info (not debug)
#    ✓ Enable error tracking (Sentry/NewRelic/etc.)
#
# 5. DEPLOYMENT
#    ✓ Run database migrations: docker-compose exec api alembic upgrade head
#    ✓ Seed compliance data: docker-compose exec api python scripts/migrate_ucl_data.py
#    ✓ Test all admin functions in UI
#    ✓ Test subscription tier upgrades via Stripe
#    ✓ Verify audit logging is working
#    ✓ Test API endpoints with curl
#
# 6. MONITORING
#    ✓ Set up uptime monitoring for /health endpoint
#    ✓ Monitor database connection pool
#    ✓ Monitor Redis memory usage
#    ✓ Set up alerts for errors and warnings
#
# 7. COMPLIANCE
#    ✓ Review data retention policies
#    ✓ Test HIPAA audit logging (tenant isolation)
#    ✓ Configure log rotation and archival
#    ✓ Enable WAF (Web Application Firewall) if on cloud
#
# Never commit this file with real secrets to git!
# Use GitHub Secrets for CI/CD deployments.
